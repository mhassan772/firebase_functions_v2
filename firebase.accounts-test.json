{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local", "workers", "accounts-page"]
  },
  "storage": {
    "rules": "scripts/emulator/storage.rules"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9096 },
    "firestore": { "host": "127.0.0.1", "port": 8089, "websocketPort": 9154 },
    "functions": { "host": "127.0.0.1", "port": 5004 },
    "storage": { "host": "127.0.0.1", "port": 9196 },
    "hub": { "host": "127.0.0.1", "port": 4404 },
    "logging": { "host": "127.0.0.1", "port": 4504 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
