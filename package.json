{
  "name": "egypt-subscription-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Egypt Subscription",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log",
    "test:rules": "bash scripts/emulator/with-java.sh firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-mantooq 'node --test test/rules/*.test.js'",
    "emulators": "bash scripts/emulator/start.sh",
    "emulators:seed": "node scripts/emulator/seed.mjs",
    "backfill:podcast-audit": "node scripts/backfill/podcast-audit.mjs"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "busboy": "^1.6.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.8.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^20.1.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.27",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
