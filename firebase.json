{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local", "workers"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
    "region": "europe-west2"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9098
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8086,
      "websocketPort": 9151
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4001
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4401
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4501
    },
    "singleProjectMode": true
  }
}
