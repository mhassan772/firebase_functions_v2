rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin portal access. A portal user's document in users_adminv2 holds either a `roles` list,
    // which alone decides access, or the older single `role`. `admin` grants every role. The
    // document is checked with exists() first so that a caller who is not a portal user reads as
    // false, not as an error, next to the owner checks these rules sit beside.
    function portalUserPath() {
      return /databases/$(database)/documents/users_adminv2/$(request.auth.uid);
    }

    function isPortalUser() {
      return request.auth != null && exists(portalUserPath());
    }

    function portalRoles() {
      let data = get(portalUserPath()).data;
      return data.get('roles', null) is list ? data.roles : [data.get('role', null)];
    }

    function hasPortalRole(role) {
      return isPortalUser() && ('admin' in portalRoles() || role in portalRoles());
    }

    function isPortalAdmin() {
      return hasPortalRole('admin');
    }

    match /book_recordings/{book_recordings} {
      allow read, write: if hasPortalRole('content-manager');

    }
    match /books_series/{books_series_id} {
      allow read, write: if hasPortalRole('content-manager');

    }
    match /server_podcasts/{id} {
      allow read, write: if hasPortalRole('content-manager');

    }
    match /books_metadata/{key} {
      allow read, write: if hasPortalRole('content-manager');

    }
    
    match /books_pre_add/{key} {
      allow read, write: if hasPortalRole('content-manager');

    }
 
    match /books_download_audit/{books_download_audit} {
      allow read, write, delete, create: if false;
    }
    // Podcast engagement behind the podcast rankings: one document per user, podcast and
    // action, holding the latest date. popularPodcastsV1 and the temporary audit triggers
    // write them through the Admin SDK. See docs/podcast-charts.md.
    match /podcast_audit/{auditId} {
      allow read, write, delete, create: if false;
    }
    // The one exception: the app records a listen to a converted podcast itself, since no
    // synced document shows it. A user writes only their own listen, stamped with the server
    // time, and re-dates it at most once a day. Conversions stay server-only.
    match /converted_podcast_audit/{auditId} {
      function isOwnConvertedListen(d) {
        return request.auth != null
          && d.keys().hasOnly(['podcast_id', 'book_guid', 'user_guid', 'action', 'timestamp'])
          && d.keys().hasAll(['podcast_id', 'book_guid', 'user_guid', 'action', 'timestamp'])
          && d.action == 'listen'
          && d.user_guid == request.auth.uid
          && d.timestamp == request.time
          && d.podcast_id is string && d.podcast_id.size() > 0 && d.podcast_id.size() <= 200
          && d.book_guid is string && d.book_guid.size() > 0 && d.book_guid.size() <= 200
          && auditId == 'listen_' + request.auth.uid + '_' + d.podcast_id;
      }

      allow read, delete: if false;
      allow create: if isOwnConvertedListen(request.resource.data);
      allow update: if isOwnConvertedListen(request.resource.data)
        && resource.data.timestamp < request.time - duration.value(1, 'd')
        && request.resource.data.podcast_id == resource.data.podcast_id
        && request.resource.data.user_guid == resource.data.user_guid;
    }
    match /podcast_audit_state/{stateId} {
      allow read, write, delete, create: if false;
    }
    // Each user's listening time per book, kept by the book listen-time triggers and counted by
    // mostPopularBooksV3 through the Admin SDK. See docs/book-chart.md.
    match /book_listeners/{lineId} {
      allow read, write, delete, create: if false;
    }
    match /admin/{adminuid} {
      allow read:if request.auth != null 
      // && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.isAdmin == true;
    allow write, delete, create: if false;
    }
    match /feedbacks/{feedback} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.isAdmin == true;
    }
    match /settings/{settings} {
      allow read, write, update, create, delete: if isPortalAdmin();
      // Content managers keep the content settings only; mantooqAppSettings and the rest stay admin.
      allow read, write, update, create, delete: if hasPortalRole('content-manager')
        && settings in ['webAdminV2UploadBooks', 'youtube', 'podcasts', 'adminWebV2GeneralSettings'];

    }
	match /settings_app/{docId}/{subpath=**} {
  allow read: if true;

  allow create, update, delete: if isPortalAdmin();
  // settings_app/subscription holds the device limits, which stay with admins.
  allow create, update, delete: if hasPortalRole('content-manager') && docId != 'subscription';
}

    
    match /system_time/{document} {
 			 allow read, write: if request.auth != null;
		}
    
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.id;
      allow create: if true;
			allow read, write: if isPortalAdmin();
}
    match /favourites/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

    }
    match /auto_reported_issues/{issueId} {
  allow create: if request.auth != null
    && request.resource.data.userId == request.auth.uid;
  allow read, update, delete: if hasPortalRole('developer');
}
    match /favorites_v2/{userId} {
 		  allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

		}
    
    match /playback_progress/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if isPortalAdmin();
      allow create, read, write, update: if isPortalAdmin();

    }
    
    match /playback_progress_v2/{userId} {

      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if isPortalAdmin();
      allow create, read, write, update: if isPortalAdmin();


      match /chunks/{docId} {
         allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
         allow read: if isPortalAdmin();
         allow create, read, write, update: if isPortalAdmin();

      }
    }
    
    match /episode_progress/{userId} {                                                                                                                                                    
    	allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;                                                                                          
   	 	allow read: if isPortalAdmin();  
      allow create, read, write, update: if isPortalAdmin();

  	}

   match /converted_podcasts/{userId} {                                                                                                                                                    
    	allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;                                                                                          
   	 	allow read: if isPortalAdmin(); 
      allow create, read, write, update: if isPortalAdmin();

  	}      

    match /podcast_subscriptions/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

    }
    
    match /episodes_lists/{userId} {
    allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    allow read: if isPortalAdmin();
    allow create, read, write, update: if isPortalAdmin();


    match /lists/{listId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if isPortalAdmin();
      allow create, read, write, update: if isPortalAdmin();

    }
  	}
    
    match /pdf_progress/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

    }
     match /completed_book/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

    }
     match /completed_books_v2/{userId} {
 		  allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

		}
     match /archived_episodes/{userId} {
 		  allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

		}
     // Podcasts and books the user blocked, one document per user. It stays its own document so older
     // app versions, which rewrite the followed-podcasts and archive documents whole, cannot erase it.
     match /blocked_content/{userId} {
 		  allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

		}
     match /playlists/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

    }
     match /playlists/{userId}/book_playlists/{id} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();

    }
     match /playlists_v2/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();
      allow read: if isPortalAdmin();
    }
     
     match /routines/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

      allow read: if isPortalAdmin();
    }
     match /routine_activity/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

      allow read: if isPortalAdmin();

    }
     match /listen_times/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

    }
     match /device_sessions/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();
      allow read: if isPortalAdmin();
    }
     match /device_sessions_v2/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create, read, write, update: if isPortalAdmin();
      allow read: if isPortalAdmin();
    }
 		match /bookmarks/{userId}/bookmarks_chunk/{book_mark_chunck} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

    }   
  	match /bookmarks/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

      allow read: if isPortalAdmin();
    }
    
     match /bookmarks/{userId}/tags/{id} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

    }
    
      match /bookmarks/{userId}/book_bookmarks/{id} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
            allow create, read, write, update: if isPortalAdmin();

    }
    // Books the user built from their own audio files: the main document lists
    // the chunks that hold them. Only the owner reads or writes them.
    match /user_books/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /user_books_chunk/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // A playlist or routine the owner shared by link. Anyone with the link reads
    // it while it is enabled, including the go.mantooq.com edge script, which
    // reads over the REST API with no auth. Only the owner sees a stopped share,
    // lists their own shares, or writes them.
    match /shared_collections/{shareId} {
      function isShareOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      // Rules cannot loop, so nested items are not checked, only the list sizes.
      function isValidShare(d) {
        return d.keys().hasAll(['type', 'ownerUid', 'sourceId', 'enabled', 'schema', 'name', 'createdAt', 'updatedAt'])
          && d.ownerUid is string
          && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 100
          && d.enabled is bool
          && d.schema is int && d.schema == 1
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.createdAt is timestamp
          && d.updatedAt is timestamp
          && (
            (d.type == 'playlist'
              && d.keys().hasOnly(['type', 'ownerUid', 'sourceId', 'enabled', 'schema', 'name', 'createdAt', 'updatedAt', 'icon', 'items'])
              && d.items is list && d.items.size() <= 1000
              && (!('icon' in d) || d.icon is map))
            || (d.type == 'routine'
              && d.keys().hasOnly(['type', 'ownerUid', 'sourceId', 'enabled', 'schema', 'name', 'createdAt', 'updatedAt', 'entries', 'playlists'])
              && d.entries is list && d.entries.size() <= 200
              && d.playlists is map && d.playlists.size() <= 50)
          );
      }

      allow get: if resource.data.enabled == true || isShareOwner();
      // Passes only for queries filtered on the caller's own ownerUid.
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && isValidShare(request.resource.data);
      allow update: if isShareOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.sourceId == resource.data.sourceId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidShare(request.resource.data);
      allow delete: if isShareOwner();
    }
    // Legacy manual grants. App versions before ~90.4 still read their own
    // document, keyed by sha256hex(uid); nothing on the client writes here any
    // more, the backend mirrors into it.
    match /subscriptions_manual/{docId} {
      allow get: if request.auth != null
                 && hashing.sha256(request.auth.uid).toHexString().lower() == docId;
      allow read: if isPortalAdmin();
      allow write: if false;
    }
    match /subscriptions_to_be_approved/{subscriptionId} {
      allow read: if hasPortalRole('egypt-subscription-approval');
      allow write: if hasPortalRole('egypt-subscription-approval');
      allow read: if request.auth != null && request.auth.uid == resource.data.user_guid;

    }
    
   match /subscription_migration_restoration/{subscriptionId} {
  allow read: if hasPortalRole('egypt-subscription-approval');
  allow write: if hasPortalRole('egypt-subscription-approval');
  allow read: if request.auth != null && request.auth.uid == resource.data.user_guid;

} 
    
    
    match /users/{userId}/downloaded_books/{book_d} {
      allow read, update, delete, create: if request.auth != null

    }
    
    match /donation_web/main {
      allow read: if request.auth != null ;
      allow write: if isPortalAdmin();
    }
    
    match /publishers/{publisher_id} {
      allow read, write, create: if hasPortalRole('content-manager');

    }
    
    // Every portal user records what they did; only admins read or change the history.
    match /logs_adminv2/{log_id} {
      allow create: if isPortalUser();
      allow read, update, delete: if isPortalAdmin();

    }
    match /podcasts_filtering/{setting} {
      allow read, write, create: if isPortalAdmin();

    }
    match /reporting_issues/{setting} {
      allow read, write, create, delete: if hasPortalRole('developer');

    }
    // A user's report of a podcast or a book, one per user and item: the id is the reporter's uid
    // and the item's id, and users cannot update, so a second report of the same item is refused.
    // The reporter may get their own report to learn they already sent it; only admins list or act.
    match /content_reports/{reportId} {
      function isText(value, min, max) {
        return value is string && value.size() >= min && value.size() <= max;
      }

      function isValidEpisode(e) {
        return e is map
          && e.keys().hasOnly(['episodeId', 'title', 'image'])
          && e.keys().hasAll(['episodeId', 'title', 'image'])
          && e.episodeId is string && e.episodeId.matches('e-[0-9]{1,20}')
          && isText(e.title, 0, 500)
          && isText(e.image, 0, 2048);
      }

      function isValidCopyright(c) {
        return c is map
          && c.keys().hasOnly(['claimantName', 'email', 'relationship', 'originalWork', 'statementAccepted'])
          && c.keys().hasAll(['claimantName', 'email', 'relationship', 'originalWork', 'statementAccepted'])
          && isText(c.claimantName, 1, 200)
          && isText(c.email, 3, 320) && c.email.matches('[^@ ]+@[^@ ]+')
          && c.relationship in ['owner', 'agent']
          && isText(c.originalWork, 1, 2000)
          && c.statementAccepted == true;
      }

      function isOwnReport(d) {
        return request.auth != null
          && d.keys().hasOnly(['uid', 'contentType', 'contentId', 'title', 'image', 'episode', 'reason',
               'request', 'details', 'copyright', 'status', 'appVersion', 'platform', 'createdAt'])
          && d.keys().hasAll(['uid', 'contentType', 'contentId', 'title', 'image', 'reason', 'request',
               'status', 'appVersion', 'platform', 'createdAt'])
          && d.uid == request.auth.uid
          && d.contentId is string
          && reportId == request.auth.uid + '_' + d.contentId
          && ((d.contentType == 'podcast' && d.contentId.matches('p-[0-9]{1,20}'))
              || (d.contentType == 'book' && d.contentId.matches('[A-Za-z0-9_-]{1,128}')))
          && isText(d.title, 0, 500)
          && isText(d.image, 0, 2048)
          && (!('episode' in d) || (d.contentType == 'podcast' && isValidEpisode(d.episode)))
          && d.reason in ['content', 'picture', 'both', 'copyright']
          && d.request in ['remove', 'hide_picture']
          && (d.request == 'remove' || d.reason in ['picture', 'both'])
          && (d.reason == 'copyright') == ('copyright' in d)
          && (!('copyright' in d) || isValidCopyright(d.copyright))
          && (!('details' in d) || isText(d.details, 0, 2000))
          && d.status == 'pending'
          && isText(d.appVersion, 1, 40)
          && isText(d.platform, 1, 20)
          && d.createdAt == request.time;
      }

      allow create: if isOwnReport(request.resource.data);
      // Matched on the id as well, so a missing report reads as missing only to its would-be owner.
      allow get: if request.auth != null
        && reportId.matches(request.auth.uid + '_.+')
        && (resource == null || resource.data.uid == request.auth.uid);
      allow read, write: if isPortalAdmin();
    }
    
    // Users collection - authenticated users can read their own document
    // Portal access, edited by admins on the portal's Portal users page. Roles come from a
    // fixed list, and the legacy `role` field is never written from the client.
    function validPortalAccess(data) {
      return data.active is bool
        && data.roles is list
        && data.roles.hasOnly(['admin', 'content-manager', 'egypt-subscription-approval', 'developer'])
        && data.roles.toSet().size() == data.roles.size()
        && (data.active == false || data.roles.size() > 0)
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    // An admin can't take away their own admin access or sign-in.
    function keepsOwnAdmin(userId, data) {
      return userId != request.auth.uid || (data.active == true && 'admin' in data.roles);
    }

    function pendingPortalUserPath(userId) {
      return /databases/$(database)/documents/users_not_activated_adminv2/$(userId);
    }

    match /users_adminv2/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isPortalAdmin();
      allow update: if isPortalAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'active', 'updatedAt', 'updatedBy'])
        && validPortalAccess(request.resource.data)
        && keepsOwnAdmin(userId, request.resource.data);
      // Activating a sign-in: created from its waiting-list entry, which the same batch deletes.
      allow create: if isPortalAdmin()
        && exists(pendingPortalUserPath(userId))
        && !existsAfter(pendingPortalUserPath(userId))
        && request.resource.data.keys().hasOnly(['email', 'roles', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('email', null) == get(pendingPortalUserPath(userId)).data.get('email', null)
        && validPortalAccess(request.resource.data);
      allow delete: if false;
    }
    // users_my_mantooq collection - authenticated users can read their own document
    match /users_my_mantooq/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only admins should write via admin SDK
    }
    
    // Portal sign-ups waiting for an admin. Each user creates and reads only their own request;
    // admins read them all. adminManagePortalUsers moves a request into users_adminv2.
    match /users_not_activated_adminv2/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isPortalAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
      // Only as part of activating the sign-in, in the batch that creates its users_adminv2 document.
      allow delete: if isPortalAdmin()
        && !exists(/databases/$(database)/documents/users_adminv2/$(userId))
        && existsAfter(/databases/$(database)/documents/users_adminv2/$(userId));
    }
    match /re_user_liked_comments/{userId}/{book_guid}/{commenter_guid} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }		
    match /re_user_flagged_comments/{userId}/{book_guid}/{commenter_guid} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }	    
    
    
    match /re_review_book/{book_guid} {
      allow read: if request.auth != null ;
    }
    match /re_review_content/{comment_id} {
      allow read: if request.auth != null ;
    }
    match /authors/{author} {
      allow read: if true;
      allow write, delete: if hasPortalRole('content-manager');
    }

    
    match /books/{book} {
      allow read: if true;
      allow write: if hasPortalRole('content-manager');

    }
    match /books_copy_rights/{book} {
      allow read, write: if hasPortalRole('content-manager');

    }
    
    match /categories/{category} {
      allow read: if true;
      allow write: if hasPortalRole('content-manager');
    }
    
    match /narrators/{narrator} {
      allow read: if true;
    }
    match /popular_books/{popular_books} {
      allow read: if true;
    }
    
    match /popular_books_v2/{popular_books} {
      allow read: if true;
    }

    // Written only by popularPodcastsV1. Public like popular_books_v2: new
    // listeners browsing as guests see the same ranking.
    match /popular_podcasts_v2/{ranking} {
      allow read: if true;
      allow write: if false;
    }
    
    
    //SUBSCRIPTION
    match /subscription_master/{uid} {
      allow get: if request.auth != null
                 && request.auth.uid == uid;

      allow list, create, update, delete: if false;
    }

    match /subscription_purchase_ownership/{document=**} {
      allow read, write: if false;
    }

    match /subscription_store_state/{document=**} {
      allow read, write: if false;
    }

    match /subscription_migration_runs/{document=**} {
      allow read, write: if false;
    }

    match /subscription_store_events/{document=**} {
      allow read, write: if false;
    }

    match /subscription_acknowledgements/{document=**} {
      allow read, write: if false;
    }

    match /subscription_reconcile_state/{document=**} {
      allow read, write: if false;
    }

    // Admin dashboard stats, rebuilt daily by refreshSubscriptionStats.
    match /subscription_stats/{id} {
      allow read: if isPortalAdmin();
      allow write: if false;
    }

    match /subscription_stats_daily/{id} {
      allow read: if isPortalAdmin();
      allow write: if false;
    }

		
    // DONATION PAGE
    // Storefront catalog: public read, server-only writes.
    match /DONATE_books/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    // Donor records and mail audit log: server-only (Cloud Functions /
    // Admin SDK bypass these rules).
    match /DONATE_donations/{donationId} {
      allow read, write: if false;
    }
    match /DONATE_mail_log/{logId} {
      allow read, write: if false;
    }
    
    match /{document=**} {
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }
  }
}